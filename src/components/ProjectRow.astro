---
interface Props {
  index: number;
  title: string;
  summary: string;
  tech: readonly string[];
  year: string;
  href: string;
  /** The index page shows a tighter row than the full work list. */
  compact?: boolean;
}

const { index, title, summary, tech, year, href, compact = false } = Astro.props;

const number = String(index).padStart(2, "0");
---

<a class:list={["row", { "row--compact": compact }]} href={href}>
  <span class="row__number label" aria-hidden="true">{number}</span>

  <span class="row__body">
    <span class="row__title">{title}</span>
    {!compact && <span class="row__summary">{summary}</span>}
  </span>

  <span class="row__meta">
    <span class="row__tech label">{tech.join(" · ")}</span>
    <span class="row__year label">{year}</span>
  </span>

  <span class="row__arrow" aria-hidden="true">→</span>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto 1.5rem;
    align-items: baseline;
    gap: var(--space-m);
    padding-block: var(--space-m);
    border-bottom: var(--rule) solid var(--rule-color);
    transition: color var(--dur) var(--ease);
  }

  /* First row carries its own top rule so a list reads as a closed block. */
  .row:first-of-type {
    border-top: var(--rule) solid var(--rule-color);
  }

  .row:hover {
    color: var(--accent);
  }

  .row__number {
    color: var(--fg-faint);
    transition: color var(--dur) var(--ease);
  }

  .row:hover .row__number {
    color: var(--accent);
  }

  .row__body {
    display: grid;
    gap: var(--space-2xs);
    min-width: 0;
  }

  .row__title {
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: var(--track-heading);
    font-weight: 600;
    /*
     * With no accent colour there's no hue to shift on hover, so the row
     * signals itself by drawing an underline out from the left instead.
     */
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% 1px;
    transition: background-size var(--dur) var(--ease);
  }

  .row:hover .row__title {
    background-size: 100% 1px;
  }

  .row--compact .row__title {
    font-size: var(--step-1);
  }

  .row__summary {
    color: var(--fg-muted);
    font-size: var(--step-0);
    line-height: 1.45;
    max-width: 52ch;
    transition: color var(--dur) var(--ease);
  }

  .row:hover .row__summary {
    color: var(--fg);
  }

  .row__meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-m);
    justify-content: flex-end;
    text-align: right;
  }

  .row__year {
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }

  .row__arrow {
    justify-self: end;
    color: var(--fg-faint);
    transition: transform var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .row:hover .row__arrow {
    color: var(--accent);
    transform: translateX(0.25rem);
  }

  @media (max-width: 48rem) {
    .row {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1.25rem;
      row-gap: var(--space-xs);
    }

    .row__meta {
      grid-column: 2 / 3;
      justify-content: flex-start;
      text-align: left;
      gap: var(--space-s);
    }

    .row__arrow {
      grid-row: 1;
      grid-column: 3;
    }
  }
</style>
