---
/*
 * Takes the place of the theme's PostCardPreview: same bordered-card idea,
 * carrying project metadata instead of a post date and tags.
 */
import type { CollectionEntry } from "astro:content";

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { title, summary, tech, year, status } = project.data;
---

<article
  class="w-full rounded-2xl border border-line px-5 py-4 text-left backdrop-blur-sm transition hover:border-line"
>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h3 class="text-lg font-bold tracking-tight sm:text-xl">
      <a href={`/projects/${project.id}`}>{title}</a>
    </h3>
    <span class="text-ink-dim text-xs">{year} &middot; {status}</span>
  </div>

  <p class="mt-2 mb-3 text-sm">{summary}</p>

  <ul class="flex list-none flex-wrap gap-2 p-0" role="list">
    {
      tech.map((item) => (
        <li class="text-ink-dim rounded-full border border-line px-2 py-0 text-xs">
          {item}
        </li>
      ))
    }
  </ul>
</article>
