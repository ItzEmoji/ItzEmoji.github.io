---
/*
 * Adapted from the Space Ahead theme by Siddhesh Thadeshwar (GPL-3.0).
 * Theme credit lives in the README and LICENSE rather than in the page.
 */
import { site } from "../../site.config";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer text-xs sm:text-sm">
  <div
    class="flex min-w-full flex-col items-center justify-center border-t border-line"
  >
    <div
      class="flex flex-row items-center justify-around gap-2 pt-6 pb-3 text-center sm:justify-center sm:gap-6 sm:px-6"
    >
      {
        /* Text kept tight against the tags: on its own line the anchor
           renders as `<a> Home </a>` and the underline covers the spaces. */
        site.footerNavLinks.map((link) => (
          <a href={link.href} title={link.text}>{link.text}</a>
        ))
      }
    </div>
  </div>

  <div class="flex min-w-full items-center justify-center px-4 pb-8">
    <p class="mb-0 text-balance">
      &copy; {currentYear} {site.author.name}
    </p>
  </div>
</footer>
