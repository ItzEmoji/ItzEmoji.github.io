---
/**
 * The only interactive element on the site, and the only client-side JavaScript.
 * Inline rather than bundled — a separate network request for ~15 lines is worse
 * than the bytes it saves.
 */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="Switch colour theme"
>
  <span class="theme-toggle__mark" aria-hidden="true"></span>
  <span class="theme-toggle__text" data-theme-label>Theme</span>
</button>

<script is:inline>
  (function () {
    var button = document.querySelector("[data-theme-toggle]");
    if (!button) return;

    var label = button.querySelector("[data-theme-label]");
    var root = document.documentElement;

    function current() {
      var set = root.getAttribute("data-theme");
      if (set === "light" || set === "dark") return set;
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }

    function render() {
      var theme = current();
      if (label) label.textContent = theme === "dark" ? "Dark" : "Light";
      button.setAttribute(
        "aria-label",
        "Switch to " + (theme === "dark" ? "light" : "dark") + " theme",
      );
    }

    button.addEventListener("click", function () {
      var next = current() === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {
        /* preference simply won't persist */
      }
      render();
    });

    // Track the OS while the reader has made no explicit choice of their own.
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", function () {
        if (!root.getAttribute("data-theme")) render();
      });

    render();
  })();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    transition: color var(--dur) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--fg);
  }

  /* A filled square that inverts with the theme — reads at a glance, no icon set. */
  .theme-toggle__mark {
    width: 0.62rem;
    height: 0.62rem;
    border: 1px solid currentColor;
    background: currentColor;
    transition: background-color var(--dur) var(--ease);
  }

  :global(:root[data-theme="dark"]) .theme-toggle__mark {
    background: transparent;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .theme-toggle__mark {
      background: transparent;
    }
  }
</style>
