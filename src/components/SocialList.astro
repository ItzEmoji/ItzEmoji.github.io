---
import { site } from "../../site.config";

/**
 * Entries without a URL (Discord) render as copyable text rather than a dead
 * anchor — a link that goes nowhere is worse than no link.
 */
---

<dl class="socials">
  {
    site.socials.map((social) => (
      <div class="socials__item">
        <dt class="label socials__name">{social.name}</dt>
        <dd class="socials__value">
          {social.url ? (
            <a
              class="link"
              href={social.url}
              rel={social.verify ? "me noopener" : "noopener"}
            >
              {social.handle}
            </a>
          ) : (
            <span class="mono socials__handle">{social.handle}</span>
          )}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .socials {
    margin: 0;
    border-top: var(--rule) solid var(--rule-color);
  }

  .socials__item {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-m);
    align-items: baseline;
    padding-block: var(--space-s);
    border-bottom: var(--rule) solid var(--rule-color);
  }

  .socials__name {
    color: var(--fg-faint);
  }

  .socials__value {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .socials__handle {
    color: var(--fg-muted);
  }

  @media (max-width: 34rem) {
    .socials__item {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }
  }
</style>
