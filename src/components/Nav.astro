---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../../site.config";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

/** "/projects/aeroflare" should still light up the Work item. */
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);

const [given, family] = site.author.name.split(" ");
---

<header class="masthead">
  <div class="shell masthead__inner">
    <a class="wordmark" href="/" aria-label={`${site.author.name} — home`}>
      <span class="wordmark__line">{given}</span>
      <span class="wordmark__line">{family}</span>
    </a>

    <div class="masthead__right">
      <nav aria-label="Primary">
        <ul class="nav" role="list">
          {
            site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={["nav__link", { "is-active": isActive(item.href) }]}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
  <div class="shell"><hr class="rule" /></div>
</header>

<style>
  .masthead__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-m);
  }

  .wordmark {
    display: grid;
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    line-height: 1.15;
  }

  .wordmark__line {
    display: block;
  }

  /* Second line drops back so the mark reads as one object, not two words. */
  .wordmark__line:last-child {
    color: var(--fg-muted);
    transition: color var(--dur) var(--ease);
  }

  .wordmark:hover .wordmark__line:last-child {
    color: var(--fg);
  }

  .masthead__right {
    display: flex;
    align-items: flex-start;
    gap: var(--space-m);
  }

  .nav {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.15rem var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    transition: color var(--dur) var(--ease);
  }

  .nav__link:hover {
    color: var(--fg);
  }

  .nav__link.is-active {
    color: var(--accent);
  }

  @media (max-width: 34rem) {
    .masthead__inner {
      flex-direction: column;
      gap: var(--space-s);
    }

    .masthead__right {
      width: 100%;
      justify-content: space-between;
      align-items: center;
    }

    .nav {
      grid-template-columns: repeat(4, auto);
      gap: var(--space-s);
    }
  }
</style>
