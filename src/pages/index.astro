---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Button from "../components/Button.astro";
import { site } from "../../site.config";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<MainLayout activePage="home" title={site.title} bareTitle>
  <section
    class="my-12 flex w-full flex-col gap-6 px-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="w-full">
      <span
        class="tag rounded-full border border-gray-500 px-2 py-0 text-xs font-light"
      >
        {site.hero.eyebrow}
      </span>

      <h1 class="text-balance leading-tight sm:pt-0">{site.hero.title}</h1>

      <p class="text-balance text-xs sm:text-base">{site.hero.text}</p>

      <div
        class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-4 text-xs sm:mt-10 sm:text-base"
      >
        {
          site.hero.actions.map((action, index) => (
            <Button
              href={action.href}
              class={index === 0 ? "space-btn-filled" : "space-btn-outlined"}
            >
              {action.text}
            </Button>
          ))
        }
      </div>
    </div>
  </section>

  <div class="page-content">
    <section id="work" class="flex w-full flex-col items-center justify-center">
      <h2 class="text-balance pt-0 pb-8">Work</h2>

      <div class="flex max-w-full flex-col gap-6 text-left">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>

      <Button href="/projects" class="space-btn-filled mt-8">
        All work
      </Button>
    </section>
  </div>
</MainLayout>
