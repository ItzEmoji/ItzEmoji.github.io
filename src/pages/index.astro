---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { site } from "../../site.config";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={site.title} bareTitle>
  <section class="shell hero">
    <p class="label hero__eyebrow">
      {site.author.location} — {site.author.role}
    </p>

    <h1 class="display hero__name">
      Cyril<br />Dettling
    </h1>

    <p class="hero__statement">
      I'm sixteen, training as a platform engineer at the
      <strong>{site.author.employer}</strong>, and I build declarative Linux
      infrastructure with Nix — caches, images, and systems that rebuild
      themselves the same way every time.
    </p>
  </section>

  <section class="shell section" aria-labelledby="work-heading">
    <div class="section__head">
      <h2 id="work-heading" class="label">Selected work</h2>
      <a class="section__more label" href="/projects">All work →</a>
    </div>

    <div class="work">
      {
        projects.map((project) => (
          <ProjectRow
            index={project.data.order}
            title={project.data.title}
            summary={project.data.summary}
            tech={project.data.tech}
            year={project.data.year}
            href={`/projects/${project.id}`}
          />
        ))
      }
    </div>
  </section>

  <section class="shell section" aria-labelledby="now-heading">
    <h2 id="now-heading" class="label">Currently</h2>
    <div class="now">
      <p class="now__text">
        Working through my apprenticeship as an <em>Informatiker EFZ,
        Fachrichtung Plattformentwicklung</em>, and spending most of what's left
        of the week on <a class="link" href="/projects/aeroflare">Aeroflare</a>.
      </p>
      <p class="now__aside muted">
        Somewhere along the way I built Linux From Scratch and then put KDE
        Plasma on top of it. <a class="link" href="/about">That story's here.</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .hero__eyebrow {
    margin-bottom: var(--space-m);
  }

  /*
   * The name is the largest thing on the site and the reason the whole design
   * works — set tight, set once, and given room on every side.
   */
  .hero__name {
    margin-bottom: var(--space-l);
  }

  .hero__statement {
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.45;
    letter-spacing: -0.012em;
    color: var(--fg-muted);
  }

  .hero__statement strong {
    color: var(--fg);
    font-weight: 500;
  }

  .section__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-m);
    margin-bottom: var(--space-m);
  }

  .section__more {
    transition: color var(--dur) var(--ease);
  }

  .section__more:hover {
    color: var(--accent);
  }

  .now {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-l);
    margin-top: var(--space-m);
    padding-top: var(--space-m);
    border-top: var(--rule) solid var(--rule-color);
  }

  .now__text {
    font-size: var(--step-1);
    line-height: 1.45;
    letter-spacing: -0.01em;
    max-width: 38ch;
  }

  .now__aside {
    max-width: 38ch;
  }

  @media (max-width: 48rem) {
    .now {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }
</style>
