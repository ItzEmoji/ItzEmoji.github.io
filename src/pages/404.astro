---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/Button.astro";
---

<MainLayout activePage="" title="Not found" description="That page does not exist.">
  <div class="page-content">
    <h1 class="pt-8">404<span class="blinking">_</span></h1>

    <p class="text-left">
      This page does not exist. The link is wrong, or it used to be something
      and is not anymore.
    </p>

    <div class="flex flex-wrap gap-2 text-xs sm:text-base">
      <Button href="/" class="space-btn-filled">Home</Button>
      <Button href="/projects" class="space-btn-outlined">Work</Button>
      <Button href="/contact" class="space-btn-outlined">Contact</Button>
    </div>
  </div>
</MainLayout>
