---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Not found"
  description="That page doesn't exist."
>
  <div class="shell notfound">
    <p class="label">Error 404</p>
    <h1 class="h1 notfound__title">This page<br />doesn't exist</h1>
    <p class="notfound__text muted">
      Nothing here — the link is wrong, or it used to be something and isn't
      anymore.
    </p>
    <p class="notfound__links label">
      <a class="notfound__link" href="/">Index</a>
      <span aria-hidden="true">/</span>
      <a class="notfound__link" href="/projects">Work</a>
      <span aria-hidden="true">/</span>
      <a class="notfound__link" href="/contact">Contact</a>
    </p>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-3xl);
  }

  .notfound__title {
    margin-top: var(--space-m);
  }

  .notfound__text {
    margin-top: var(--space-m);
    max-width: 38ch;
  }

  .notfound__links {
    display: flex;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }

  .notfound__link {
    transition: color var(--dur) var(--ease);
  }

  .notfound__link:hover {
    color: var(--accent);
  }
</style>
