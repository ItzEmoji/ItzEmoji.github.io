---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialList from "../components/SocialList.astro";
import { site, email } from "../../site.config";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Cyril Dettling — email, GitHub, Mastodon, Matrix, and PGP."
>
  <div class="shell">
    <header class="page-head">
      <p class="label">Contact</p>
      <h1 class="page-head__title">Say hello</h1>
      <p class="page-head__intro">
        Email is the reliable one. Everything else works too.
      </p>
    </header>

    <hr class="rule" />

    <div class="contact">
      <section class="contact__primary" aria-labelledby="email-heading">
        <h2 id="email-heading" class="label">Email</h2>
        {/*
          The address is split across elements so it isn't one scrapable string
          in the markup, while the mailto still works with JavaScript disabled.
        */}
        <a class="contact__email" href={`mailto:${email}`}>
          <span>{site.author.email.user}</span><span aria-hidden="true">@</span
          ><span>{site.author.email.domain}</span>
        </a>

        <h2 class="label contact__subhead">PGP</h2>
        <p class="contact__pgp">
          My public keys live at
          <a class="link mono" href={site.pgp} rel="noopener">
            openpgpkey.itzemoji.com ↗
          </a>
          — they're served from there, not mirrored here.
        </p>
      </section>

      <section class="contact__secondary" aria-labelledby="elsewhere-heading">
        <h2 id="elsewhere-heading" class="label contact__subhead-first">
          Elsewhere
        </h2>
        <SocialList />
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-xl);
    padding-block: var(--space-xl);
  }

  .contact__email {
    display: inline-block;
    margin-top: var(--space-s);
    font-size: var(--step-2);
    letter-spacing: var(--track-heading);
    font-weight: 500;
    line-height: 1.2;
    overflow-wrap: anywhere;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% 1px;
    transition: color var(--dur) var(--ease),
      background-size var(--dur) var(--ease);
  }

  .contact__email:hover {
    color: var(--accent);
    background-size: 100% 1px;
  }

  .contact__subhead {
    display: block;
    margin-top: var(--space-xl);
  }

  .contact__subhead-first {
    display: block;
    margin-bottom: var(--space-s);
  }

  .contact__pgp {
    margin-top: var(--space-s);
    max-width: 40ch;
    color: var(--fg-muted);
  }

  @media (max-width: 48rem) {
    .contact {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }
</style>
