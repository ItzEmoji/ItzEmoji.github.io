---
import MainLayout from "../layouts/MainLayout.astro";
import { site, email } from "../../site.config";
---

<MainLayout
  activePage="contact"
  title="Contact"
  description="Contact Cyril Dettling. Email, GitHub, Mastodon, Matrix, and PGP."
>
  <div class="page-content">
    <h1 class="pt-8">Contact</h1>

    <div class="mx-auto max-w-2xl text-left">
      <p>Email works best. Everything else works too.</p>

      <h2>Email</h2>
      {/*
        The address is split across elements so it is not one scrapable string
        in the markup. The mailto still works with JavaScript disabled.
      */}
      <p>
        <a href={`mailto:${email}`} class="text-lg sm:text-2xl">
          <span>{site.author.email.user}</span><span aria-hidden="true">@</span
          ><span>{site.author.email.domain}</span>
        </a>
      </p>

      <h2>PGP</h2>
      <p>
        My public keys are at <a href={site.pgp} rel="noopener"
          >openpgpkey.itzemoji.com</a
        >. They are served from there, not mirrored here.
      </p>

      <h2>Elsewhere</h2>
      <dl class="mb-6 border-t border-line">
        {
          site.socials.map((social) => (
            <div class="flex flex-wrap gap-x-4 border-b border-line py-2">
              <dt class="text-ink-dim w-28 shrink-0 text-xs sm:text-sm">
                {social.name}
              </dt>
              <dd class="min-w-0 text-sm break-words">
                {social.url ? (
                  <a
                    href={social.url}
                    rel={social.verify ? "me noopener" : "noopener"}
                  >
                    {social.handle}
                  </a>
                ) : (
                  /* No profile page to link to, so it renders as copyable text. */
                  <span class="text-ink-dim">{social.handle}</span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</MainLayout>
