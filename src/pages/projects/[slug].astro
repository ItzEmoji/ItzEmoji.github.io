---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import Button from "../../components/Button.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, year, tech, repo, link, status } = project.data;
---

<MainLayout activePage="work" title={title} description={summary}>
  <div class="page-content">
    <h1 class="pt-8">{title}</h1>

    <p class="mx-auto max-w-2xl text-left">{summary}</p>

    <div class="mx-auto max-w-2xl text-left">
      <dl
        class="mb-8 flex flex-wrap gap-x-8 gap-y-2 border-y border-line py-4 text-xs"
      >
        <div>
          <dt class="text-ink-dim">Year</dt>
          <dd>{year}</dd>
        </div>
        <div>
          <dt class="text-ink-dim">Status</dt>
          <dd>{status}</dd>
        </div>
        <div>
          <dt class="text-ink-dim">Stack</dt>
          <dd>{tech.join(", ")}</dd>
        </div>
      </dl>

      <article class="prose-page">
        <Content />
      </article>

      <div class="mt-10 flex flex-wrap gap-2 text-xs sm:text-base">
        <Button href={repo} class="space-btn-filled" rel="noopener">
          Source on GitHub
        </Button>
        {
          link && (
            <Button href={link} class="space-btn-outlined" rel="noopener">
              Visit
            </Button>
          )
        }
        <Button href="/projects" class="space-btn-outlined">All work</Button>
      </div>
    </div>
  </div>
</MainLayout>
